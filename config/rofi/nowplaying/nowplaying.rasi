configuration {
    show-icons:                 false;
}

* {
    background:     #000000FF;
    background-alt: #000000FF;
    foreground:     #FFFFFFFF;
    selected:       #FFFFFFFF;
    active:         #FFFFFFFF;
    urgent:         #FFFFFFFF;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;   
    width:                       500px;
    height:                      360px;
    x-offset:                    0px;
    y-offset:                    0px;   
    enabled:                     true;
    cursor:                      "default";
    background-color:            @background;
    border:                      2px;
    border-color:                #FFFFFFFF;
    border-radius:               0px;
    padding:                     20px;
}

mainbox {
    enabled:                     true;
    spacing:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "top-message", "middle-wrapper", "listview" ];
}

top-message {
    enabled:                     true;
    padding:                     0px;
    background-color:            @background;
    children:                    [ "textbox-msg" ];
    expand:                      false;
}

textbox-msg {
    expand: true;
    background-color:            transparent;
    text-color:                  @foreground;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    str:                         "  Now Playing"; 
    font:                        "JetBrains Mono Bold 16";
}

middle-wrapper {
    enabled:                     true;
    orientation:                 horizontal;
    spacing:                     20px;
    background-color:            transparent;
    expand:                      true; 
    children:                    [ "album-art", "custom-text-box" ];
}

album-art {
    enabled:                     true;
    width:                       170px; 
    height:                      170px; 
    background-color:            @background-alt;
    background-image:            url("~/.config/rofi/nowplaying/album_art.png", height);                                  
    border:                      2px;
    border-color:                #FFFFFFFF;
    border-radius:               0px;
    expand:                      false; 
}

custom-text-box {
    enabled:                     true;
    expand:                      true;
    padding:                     20px;
    background-color:            @background-alt;
    border:                      2px;
    border-color:                #FFFFFFFF;
    border-radius:               0px;
    children:                    [ "textbox-custom" ];
}

textbox-custom {
    background-color:            transparent;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    markup:                      true; 
    font:                        "JetBrains Mono Bold 14";
    str:                         "Loading...";
}

listview {
    enabled:                     true;
    columns:                     3;
    lines:                       1;
    dynamic:                     true;
    reverse:                     false;    
    spacing:                     15px;
    background-color:            transparent;
    cursor:                      "default";
    expand:                      false; 
}

element {
    enabled:                     true;
    padding:                     12px;
    border:                      2px;
    border-color:                #FFFFFFFF;
    border-radius:               0px; 
    cursor:                      pointer;
    background-color:            @background-alt;
    text-color:                  @foreground;
    orientation:                 horizontal;
}

element selected {
    background-color:            @selected;
    text-color:                  @background;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    font:                        "JetBrains Mono 14";
}
