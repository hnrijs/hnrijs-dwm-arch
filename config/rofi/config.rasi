configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Adwaita";
    display-drun: " ";
    display-run: " ";
    display-window: " ";
    drun-display-format: "{name}";
    modi: "window,run,drun";
}

* {
    /* Minimalist Black & White Colors */
    bg: #000000;
    bg-alt: #151515;
    fg: #FFFFFF;
    fg-alt: #666666;
    accent: #FFFFFF;
    
    background-color: @bg;
    text-color: @fg;
}

window {
    width: 600px;
    border: 2px solid;
    border-color: @accent;
    border-radius: 8px;
    background-color: @bg;
    padding: 0px;
}

mainbox {
    spacing: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 15px;
    background-color: @bg;
    border: 0 0 1px 0 solid;
    border-color: @fg-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding: 0 15px 0 0;
    font: "JetBrainsMono Nerd Font 14";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-alt;
    text-color: @fg;
    background-color: transparent;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    lines: 8;
    padding: 10px;
    spacing: 5px;
    background-color: @bg;
    border: 0px;
    scrollbar: false;
}

element {
    padding: 10px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg-alt;
}

element-icon {
    size: 24px;
    padding: 0 15px 0 0;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg-alt;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: @accent;
    border: 1px solid;
    border-color: @accent;
}
